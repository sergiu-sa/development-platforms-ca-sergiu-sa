# Environment Variables For News API Application

# Server Configuration
PORT=3000

# Postgres connection string.
# Local (Homebrew installs create a superuser named after your macOS account):
#   postgresql://YOUR_USERNAME@localhost:5432/news_api
# Neon:
#   postgresql://user:password@host.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://postgres@localhost:5432/news_api

# JWT Secret - REQUIRED for authentication
JWT_SECRET=make_this_long_and_random

# CORS - optional, comma-separated origins allowed to call the API from a
# browser. Leave unset when the frontend is served from this same server;
# same-origin requests need no CORS headers.
# Example: ALLOWED_ORIGINS=https://my-frontend.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=

# Guardian Open Platform key - REQUIRED.
# https://open-platform.theguardian.com/
# Server-side only; this must never reach the browser.
GUARDIAN_API_KEY=your_guardian_key

# Optional. Minutes before cached wire stories are considered stale and the
# next request refills them. 500 upstream requests/day is the binding limit,
# and a 15-minute TTL costs ~96/day no matter how much traffic arrives.
WIRE_TTL_MINUTES=15

# Optional. Minimum gap between upstream attempts, successful or failed. Stops
# an outage from retrying on every request and draining the daily limit.
WIRE_RETRY_COOLDOWN_MINUTES=5
