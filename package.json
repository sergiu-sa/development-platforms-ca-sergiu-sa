{
  "name": "lede",
  "version": "1.0.0",
  "description": "Lede - a news wire that readers curate into published briefings",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "WEB_DEV_SERVER=http://localhost:5173 tsx watch src/index.ts",
    "dev:web": "vite",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc",
    "build:web": "vite build",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.check.json && tsc -p tsconfig.web.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "hono",
    "api",
    "typescript",
    "mysql"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@hono/node-server": "^2.0.12",
    "@hono/zod-validator": "^0.2.2",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.0",
    "hono": "^4.12.32",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.22.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.0",
    "@types/pg": "^8.20.0",
    "concurrently": "^10.0.4",
    "happy-dom": "^20.11.1",
    "prettier": "^3.2.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.10.0",
    "typescript": "^5.4.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
