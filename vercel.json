{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "framework": null,
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist/web",

  "regions": ["fra1"],

  "rewrites": [
    { "source": "/b/:slug", "destination": "/api/briefings/:slug/page" },
    { "source": "/u/:username", "destination": "/api/curators/:username/page" },
    { "source": "/api/:path*", "destination": "/api" }
  ],

  "functions": {
    "api/index.ts": {
      "includeFiles": "src/**"
    }
  },

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https://media.guim.co.uk data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/assets/(briefing.js|profile.js|lede.css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
