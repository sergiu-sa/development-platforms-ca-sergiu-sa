# Environment Variables For The Test Suite
#
# Copy to .env.test and fill in your local MySQL password.
# The test suite TRUNCATES every table between tests, so MYSQLDATABASE must be a
# throwaway database. tests/helpers/db.ts refuses to run unless its name ends
# with "_test".
#
# Create it first:
#   mysql -u root -p -e "CREATE DATABASE IF NOT EXISTS news_api_test;"

MYSQLHOST=localhost
MYSQLPORT=3306
MYSQLUSER=root
MYSQLPASSWORD=your_password_here
MYSQLDATABASE=news_api_test

# Any value works here; tests sign and verify with it.
JWT_SECRET=test_secret_not_used_anywhere_real
