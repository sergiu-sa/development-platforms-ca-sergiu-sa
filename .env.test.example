# Environment Variables For The Test Suite
#
# Copy to .env.test and adjust the username for your machine.
# The test suite TRUNCATES every table between tests, so this must point at a
# throwaway database. tests/helpers/db.ts refuses to run unless the database
# name ends with "_test".
#
# Create it first:
#   createdb news_api_test

DATABASE_URL=postgresql://postgres@localhost:5432/news_api_test

# Any value works here; tests sign and verify with it.
JWT_SECRET=test_secret_not_used_anywhere_real
